{
  "name": "sun-riseup-viewrrr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc --project tsconfig.dev.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check ./src",
    "lint:apply": "biome check ./src --write",
    "lint:unsafe": "biome check ./src --write --unsafe",
    "lint:ci": "biome ci ./src",
    "format": "biome format ./src --write",
    "format:check": "biome format ./src",
    "type-check": "tsc --noEmit",
    "type-check:dev": "tsc --noEmit --project tsconfig.dev.json",
    "dev:mock": "VITE_MOCK=true vite",
    "test:watch": "vitest",
    "test": "vitest --run",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-log": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
